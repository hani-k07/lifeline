# Copy to .env and fill in. .env is git-ignored — never commit it.

# dev (default) | demo (shows demo accounts on the login page) | prod
APP_ENV=dev

# Only sqlite is implemented today.
DB_BACKEND=sqlite
# DB_PATH=lifeline.db

# AI features are optional; the app works fully without a key.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Security
SESSION_TIMEOUT_MINUTES=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
BCRYPT_ROUNDS=12
LOG_LEVEL=INFO
